import java.sql.*;
import java.util.Hashtable;

import javax.jms.*;
import javax.naming.Context;
import javax.naming.InitialContext;

public class OracleKerberosToIbmMqJndi {

    // Oracle DB connection string
    static final String DB_URL = "jdbc:oracle:thin:@//host:port/service_name";
    static final String DB_QUERY = "SELECT your_column FROM your_table";

    // JNDI properties
    static final String JNDI_FACTORY = "com.sun.jndi.fscontext.RefFSContextFactory"; // or IBM-specific
    static final String JNDI_PROVIDER_URL = "file:/C:/JNDI-Directory"; // or ldap://host:port
    static final String QUEUE_CONN_FACTORY_JNDI = "ConnectionFactory";
    static final String QUEUE_JNDI = "Queue1";

    public static void main(String[] args) {
        Connection dbConnection = null;
        QueueConnection mqConnection = null;
        QueueSession session = null;
        QueueSender sender = null;

        try {
            // Kerberos system properties
            System.setProperty("java.security.krb5.conf", "/etc/krb5.conf");
            System.setProperty("oracle.net.authentication_services", "(KERBEROS5)");
            System.setProperty("oracle.net.kerberos5_mutual_authentication", "true");

            // Connect to Oracle using Kerberos
            dbConnection = DriverManager.getConnection(DB_URL);
            Statement stmt = dbConnection.createStatement();
            ResultSet rs = stmt.executeQuery(DB_QUERY);

            // JNDI Setup
            Hashtable<String, String> env = new Hashtable<>();
            env.put(Context.INITIAL_CONTEXT_FACTORY, JNDI_FACTORY);
            env.put(Context.PROVIDER_URL, JNDI_PROVIDER_URL);

            Context ctx = new InitialContext(env);
            QueueConnectionFactory factory = (QueueConnectionFactory) ctx.lookup(QUEUE_CONN_FACTORY_JNDI);
            Queue queue = (Queue) ctx.lookup(QUEUE_JNDI);

            // Connect to MQ via JNDI objects
            mqConnection = factory.createQueueConnection(); // optionally pass MQ user/pass
            session = mqConnection.createQueueSession(false, Session.AUTO_ACKNOWLEDGE);
            sender = session.createSender(queue);
            mqConnection.start();

            // Process DB result and send messages
            while (rs.next()) {
                String msgText = rs.getString(1);
                TextMessage msg = session.createTextMessage(msgText);
                sender.send(msg);
                System.out.println("Sent: " + msgText);
            }

        } catch (Exception e) {
            e.printStackTrace();
        } finally {
            try { if (sender != null) sender.close(); } catch (Exception ignored) {}
            try { if (session != null) session.close(); } catch (Exception ignored) {}
            try { if (mqConnection != null) mqConnection.close(); } catch (Exception ignored) {}
            try { if (dbConnection != null) dbConnection.close(); } catch (Exception ignored) {}
        }
    }
}
